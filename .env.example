# === Quiniela Mundial 2026 - Variables de entorno ===

# Seguridad (OBLIGATORIO cambiar en produccion)
JWT_SECRET=cambiar-este-secreto-en-produccion

# JWT
JWT_EXPIRY=7d

# SMTP (correo de invitaciones)
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=587
SMTP_USER=tu-email@dominio.com
SMTP_PASS=tu-password

# URL publica del frontend (para enlaces en emails)
FRONTEND_URL=http://localhost

# Puerto donde se expone la app (default: 80)
APP_PORT=80
